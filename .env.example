# Copy this file to .env and fill in your own values.
# .env is loaded automatically on startup (via dotenv) and should never be committed.

# Code required to access /host (dashboard, room control, game editor).
# If left unset, a random one is generated on every server start and printed
# to the terminal instead.
HOST_CODE=

# Port the server listens on. Defaults to 3000 if unset.
PORT=