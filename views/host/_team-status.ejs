<%# Live list of the room's teams and whether each phone can reach the internet (filled by host.js). %>
<hr class="section-divider team-status-divider">
<div id="team-status" class="team-status" data-room="<%= roomId %>">
  <div class="team-status-header">
    <p class="team-status-title">Komandos ir internetas</p>
    <%# Label/state filled by host.js from the room's setting. %>
    <button type="button" class="internet-warning-toggle secondary-btn" hidden></button>
  </div>
  <div class="team-status-list">
    <p class="team-status-empty">Kol kas neprisijungė nė viena komanda.</p>
  </div>
</div>
