<%# Live list of the room's teams and whether each phone can reach the internet (filled by host.js). %>
<hr class="section-divider team-status-divider">
<div id="team-status" class="team-status" data-room="<%= roomId %>">
  <div class="team-status-header">
    <p class="team-status-title">Komandos</p>
    <%# Label/state filled by host.js from the room's setting. %>
    <button type="button" class="internet-warning-toggle" hidden></button>
  </div>
  <div class="team-status-list">
    <p class="team-status-empty">Kol kas neprisijungė nė viena komanda.</p>
  </div>
  <%# A team playing on paper: a registered one not in the room yet, or a new one by name (options filled by host.js). %>
  <div class="team-add" hidden>
    <select class="team-add-select"></select>
    <input type="text" class="team-add-name" placeholder="Naujos komandos pavadinimas" maxlength="60" hidden>
    <button type="button" class="team-add-btn secondary-btn">Pridėti</button>
    <p class="team-add-error"></p>
  </div>
</div>
