<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<title><%= title %></title>
<link rel="stylesheet" href="/css/host.css">
<script src="/icons.js"></script>
<script src="/theme.js"></script>
</head>
<body data-nav="host">
<script src="/side-panel.js"></script>
<div id="app">
  <h1>Žaidimai</h1>
  <a class="option" href="/host"><%- icon('arrow-left') %> Atgal į kambarius</a>
  <a class="option" href="/host/games/new" id="new-game-btn"><%- icon('plus') %> Naujas žaidimas</a>

  <% if (error) { %>
    <p id="games-error"><%= error %></p>
  <% } %>

  <p id="games-file-error" hidden></p>

  <label for="import-games-input" id="import-games-btn" class="secondary-btn"><%- icon('upload') %> Importuoti (JSON / zip)</label>
  <input type="file" id="import-games-input" accept="application/json,.json,application/zip,.zip" class="file-input-hidden">

  <% if (gameList.length) { %>
    <button type="button" id="export-all-games-btn" class="secondary-btn"><%- icon('download') %> Eksportuoti visus</button>
  <% } %>

  <script id="default-rules-data" type="application/json"><%- JSON.stringify(defaultRules).replace(/</g, '\\u003c') %></script>
  <div id="default-rules">
    <p class="hint-text">Šios taisyklės automatiškai pridedamos kiekvienam naujam žaidimui.</p>
    <p id="default-rules-status" class="hint-text"></p>
  </div>

  <% if (draftList.length) { %>
    <div id="drafts-section">
      <p class="section-label">Juodraščiai:</p>
      <% draftList.forEach(function(d) { %>
        <div class="room-row draft-row">
          <a class="option" href="/host/drafts/<%= d.id %>/edit"><%= d.name || 'Be pavadinimo' %> (<%= d.stageCount %> etapai, <%= d.questionCount %> klausimai)</a>
          <button class="room-close-btn draft-delete-btn" data-id="<%= d.id %>" title="Ištrinti juodraštį"><%- icon('close') %></button>
        </div>
      <% }); %>
      <% if (gameList.length) { %><hr class="section-divider games-divider"><% } %>
    </div>
  <% } %>

  <% if (gameList.length) { %>
    <p class="section-label">Sukurti žaidimai:</p>
    <% gameList.forEach(function(g) { %>
      <div class="room-row">
        <a class="option" href="/host/games/<%= g.id %>/edit"><%= g.name %> (<%= g.stageCount %> etapai, <%= g.questionCount %> klausimai)</a>
        <a class="room-close-btn game-preview-btn" href="/host/games/<%= g.id %>/preview" title="Peržiūrėti žaidimą"><%- icon('play') %></a>
        <button type="button" class="room-close-btn game-export-btn" data-id="<%= g.id %>" title="Eksportuoti žaidimą"><%- icon('download') %></button>
        <button class="room-close-btn game-delete-btn" data-id="<%= g.id %>" title="Ištrinti žaidimą"><%- icon('close') %></button>
      </div>
    <% }); %>
  <% } %>
</div>
<script src="/vendor/jszip.min.js"></script>
<script src="/game-shared.js"></script>
<script src="/game-media-zip.js"></script>
<script src="/game-export.js"></script>
<script src="/game-editor-core.js"></script>
<script src="/games-list.js"></script>
</body>
</html>
