<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<title><%= title %></title>
<link rel="stylesheet" href="/css/host.css">
<script src="/icons.js"></script>
<script src="/theme.js"></script>
</head>
<body data-nav="host">
<script src="/side-panel.js"></script>
<div id="app">
  <h1><%= roomName %></h1>
  <p id="room-code"><% if (leaderboardView === 'season') { %>Sezono rezultatai<% } else if (leaderboardView === 'penalties') { %>Nuobaudos taškai<% } else { %>Rezultatai<% } %></p>
  <div id="leaderboard">
    <% if (leaderboard.length === 0) { %>
      <p><%= leaderboardView === 'penalties' ? 'Nė viena komanda negavo nuobaudos taškų.' : 'Nė viena komanda neatsakė į klausimus.' %></p>
    <% } %>
    <% leaderboard.forEach(function(row, i) { %>
      <div class="leaderboard-row">
        <span class="leaderboard-rank"><%= i + 1 %>.</span>
        <span class="leaderboard-name"><%= row.name %></span>
        <span class="leaderboard-score"><%= row.score %></span>
      </div>
    <% }); %>
  </div>
  <nav id="host-bar">
    <div class="host-bar-side">
      <a id="host-bar-exit" class="host-bar-btn" href="/host" title="Atgal į skydelį"><%- icon('close') %></a>
    </div>
    <div class="host-bar-main">
      <%# One button per view not shown now, always in this order; each flips every screen to it. %>
      <% if (seasonId) { %>
        <% [['game', 'Rodyti žaidimo taškus'], ['season', 'Rodyti sezono taškus'], ['penalties', 'Rodyti nuobaudos taškus']].forEach(function(v) { %>
          <% if (v[0] !== leaderboardView) { %>
            <button class="leaderboard-view-btn" data-id="<%= roomId %>" data-view="<%= v[0] %>"><%= v[1] %></button>
          <% } %>
        <% }); %>
      <% } %>
      <button id="finish-game-btn" data-id="<%= roomId %>">Baigti žaidimą</button>
    </div>
    <div class="host-bar-end">
      <%- include('_text-scale', { roomId }) %>
    </div>
  </nav>
</div>
<script src="/host.js"></script>
</body>
</html>
