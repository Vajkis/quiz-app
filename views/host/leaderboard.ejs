<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="stylesheet" href="/css/host.css">
</head>
<body>
<div id="app">
  <h1><%= roomName %></h1>
  <p id="room-code"><% if (showSeason) { %>Sezono rezultatai<% } else { %>Rezultatai<% } %></p>
  <div id="leaderboard">
    <% if (leaderboard.length === 0) { %>
      <p>Nė viena komanda neatsakė į klausimus.</p>
    <% } %>
    <% leaderboard.forEach(function(row, i) { %>
      <div class="leaderboard-row">
        <span class="leaderboard-rank"><%= i + 1 %>.</span>
        <span class="leaderboard-name"><%= row.name %></span>
        <span class="leaderboard-score"><%= row.score %></span>
      </div>
    <% }); %>
  </div>
  <nav id="host-bar">
    <div class="host-bar-side">
      <a id="host-bar-exit" class="host-bar-btn" href="/host" title="Atgal į skydelį">✕</a>
    </div>
    <div class="host-bar-main">
      <% if (seasonId) { %>
        <button id="season-toggle-btn" data-id="<%= roomId %>"><%= showSeason ? 'Rodyti žaidimo taškus' : 'Rodyti sezono taškus' %></button>
      <% } %>
      <button id="finish-game-btn" data-id="<%= roomId %>">Baigti žaidimą</button>
    </div>
  </nav>
</div>
<script src="/host.js"></script>
</body>
</html>
