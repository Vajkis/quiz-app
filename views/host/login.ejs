<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<title><%= title %></title>
<link rel="stylesheet" href="/css/host.css">
<script src="/icons.js"></script>
<script src="/theme.js"></script>
</head>
<body>
<div class="theme-toggles">
  <button type="button" class="theme-toggle-btn" data-toggle="colorless"></button>
  <button type="button" class="theme-toggle-btn" data-toggle="contrast"></button>
  <button type="button" class="theme-toggle-btn" data-toggle="theme"></button>
</div>
<div id="app">
  <h1>Hosto prisijungimas</h1>

  <% if (error) { %>
    <p id="login-error"><%= error %></p>
  <% } %>

  <form method="POST" action="/host/login" id="host-login-form">
    <input type="hidden" name="next" value="<%= next %>">
    <input type="password" name="code" id="host-code-input" placeholder="Prieigos kodas" autofocus autocomplete="off">
    <button type="submit" id="host-login-btn">Prisijungti</button>
  </form>
</div>
</body>
</html>
