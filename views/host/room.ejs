<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="stylesheet" href="/css/host.css">
</head>
<body>
<div id="app">
  <h1><%= roomName %></h1>
  <p id="room-code">Kambario kodas: <strong><%= roomId %></strong> · <strong><%= gameName %></strong></p>
  <p id="stage-info">Etapas <%= stageNumber %> / <%= stageCount %>: <strong><%= stageName %></strong></p>
  <% if (shownQuestionCount > 0) { %>
    <%# Every question of the stage shown so far, to jump to; the one on screen now is active. %>
    <nav class="question-jump" data-room="<%= roomId %>" aria-label="Parodyti klausimai">
      <% for (let i = 0; i < shownQuestionCount; i++) { %>
        <button type="button" class="question-jump-btn<%= i === currentQuestionNumber - 1 ? ' active' : '' %>" data-index="<%= i %>"<% if (i === currentQuestionNumber - 1) { %> aria-current="true"<% } %>><%= i + 1 %></button>
      <% } %>
    </nav>
  <% } %>

  <div class="question">
    <% if (currentQuestionText != null) { %>
      <p><%= currentQuestionText ? currentQuestionNumber + '. ' + currentQuestionText : currentQuestionNumber + ' klausimas' %></p>
      <% if (currentQuestionType === 'text') { %>
        <% if (currentQuestionAnswerCount > 1) { %>
          <p class="question-type-label">Įvedami atsakymai: <%= currentQuestionAnswerCount %></p>
          <%- include('_order-label', { ordered: currentQuestionOrdered }) %>
        <% } else { %>
          <p class="question-type-label">Įvedamas atsakymas (be variantų)</p>
        <% } %>
      <% } else if (currentQuestionType === 'yesno') { %>
        <p class="question-type-label">Taip / Ne</p>
      <% } else if (currentQuestionType === 'chain') { %>
        <p class="question-type-label">Grandinėlė</p>
        <ol class="chain-clues">
          <% currentQuestionLinks.forEach(function(l) { %>
            <li><% if (l.img) { %><img class="chain-clue-img" src="<%= l.img %>" alt=""><% } else { %><%= l.clue %><% } %></li>
          <% }); %>
        </ol>
      <% } else if (currentQuestionHints) { %>
        <p class="question-type-label">Užuominos: parodyta <%= revealedHints %> iš <%= currentQuestionHints.length %></p>
        <ol class="chain-clues hint-list">
          <% currentQuestionHints.forEach(function(h, i) { %>
            <li class="<%= i < revealedHints ? '' : 'is-hidden-hint' %>"><%= h %></li>
          <% }); %>
        </ol>
      <% } %>
      <% if (currentQuestionBonus) { %>
        <p class="question-type-label bonus-label">Papildomas klausimas<%= currentQuestionBonus.question ? ': ' + currentQuestionBonus.question : '' %></p>
      <% } %>
    <% } else { %>
      <p>Dar neparodytas nė vienas klausimas.</p>
    <% } %>
    <%- include('_audio-player', { roomId, audio: currentQuestionAudio, audioStart: currentQuestionAudioStart, audioEnd: currentQuestionAudioEnd }) %>
    <%- include('_fullscreen-buttons', {
      roomId,
      imageButtons: currentQuestionImg ? [{ src: currentQuestionImg, label: '🔍 Nuotrauką per visą ekraną' }] : [],
      optionImages: currentQuestionOptionImages,
      optionsLabel: currentQuestionType === 'chain' ? '🔍 Užuominas per visą ekraną' : null,
    }) %>
  </div>

  <nav id="host-bar">
    <div class="host-bar-side">
      <a id="host-bar-exit" class="host-bar-btn" href="/host" title="Atgal į skydelį">✕</a>
      <% if (currentQuestionAudio) { %>
        <button type="button" id="host-bar-audio" class="host-bar-btn" title="Groti / pauzė" aria-label="Groti">▶</button>
        <button type="button" id="host-bar-audio-stop" class="host-bar-btn" title="Stabdyti" aria-label="Stabdyti">■</button>
      <% } %>
    </div>
    <div class="host-bar-main">
      <% if (hasPrevious) { %>
        <button id="prev-btn" data-room="<%= roomId %>">← Ankstesnis</button>
      <% } %>
      <button id="next-btn" data-room="<%= roomId %>"><%= currentQuestionHints && revealedHints < currentQuestionHints.length ? 'Kita užuomina →' : hasMore ? 'Kitas klausimas →' : 'Rodyti etapo atsakymus' %></button>
    </div>
    <% if (currentQuestionImg || currentQuestionOptionImages) { %>
      <div class="host-bar-end">
        <button type="button" id="host-bar-fullscreen" class="host-bar-btn" title="Per visą ekraną (žiūrovų ekrane)" aria-label="Per visą ekraną" aria-pressed="false"
          data-room="<%= roomId %>"
          <% if (currentQuestionImg) { %>data-src="<%= currentQuestionImg %>"<% } %>
          <% if (currentQuestionOptionImages) { %>data-images='<%- JSON.stringify(currentQuestionOptionImages).replace(/'/g, "&#39;") %>'<% } %>>
          <svg class="fullscreen-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg>
        </button>
      </div>
    <% } %>
  </nav>
  <%- include('_team-status', { roomId }) %>
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/host.js"></script>
</body>
</html>
