<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="stylesheet" href="/css/host.css">
<script src="/icons.js"></script>
<script src="/theme.js"></script>
</head>
<body data-nav="host">
<script src="/side-panel.js"></script>
<div id="app">
  <h1><%= roomName %></h1>
  <p id="room-code">Teisingi atsakymai: <strong><%= review.stageName %></strong></p>

  <div id="stage-review">
    <% review.questions.forEach(function(q) { %>
      <div class="question">
        <p><%= q.number %>. <%= q.question %></p>
        <% if (q.chain) { %>
          <ol class="chain-clues">
            <% q.chain.forEach(function(l) { %>
              <li><% if (l.img) { %><img class="chain-clue-img" src="<%= l.img %>" alt=""><% } else { %><%= l.clue %><% } %> — <strong><%= l.answer %></strong></li>
            <% }); %>
          </ol>
        <% } else { %>
          <% if (q.hints) { %>
            <ol class="chain-clues hint-list">
              <% q.hints.forEach(function(h) { %>
                <li><%= h %></li>
              <% }); %>
            </ol>
          <% } %>
          <p class="correct-answer"><%= q.correctAnswer %></p>
        <% } %>
        <% if (q.bonus) { %>
          <p class="bonus-answer"><%- icon('plus') %> <%= q.bonus.question || 'Papildomas' %>: <strong><%= q.bonus.answer %></strong></p>
        <% } %>
        <%- include('_audio-player', { roomId, audio: q.audio, audioStart: q.audioStart, audioEnd: q.audioEnd }) %>
        <%
          const imgButtons = [];
          if (q.img) imgButtons.push({ src: q.img, label: 'Klausimo nuotrauką' });
          if (q.correctAnswerImg) imgButtons.push({ src: q.correctAnswerImg, label: 'Atsakymo nuotrauką' });
        %>
        <%- include('_fullscreen-buttons', { roomId, imageButtons: imgButtons, optionImages: q.clueImages, optionsLabel: 'Užuominas per visą ekraną' }) %>
      </div>
    <% }); %>
  </div>

  <% const typedQuestions = review.questions.filter(function(q) { return typedAnswers[q.number - 1]; }); %>
  <% if (typedQuestions.length) { %>
    <div id="typed-answers-review">
      <p class="typed-answers-title">Įrašyti atsakymai</p>
      <% typedQuestions.forEach(function(q) { const review = typedAnswers[q.number - 1]; %>
        <div class="question typed-answers">
          <p><%= q.number %>. <%= q.question %></p>
          <% if (review.answerCount > 1) { %>
            <%- include('_order-label', { ordered: review.ordered }) %>
          <% } %>
          <p class="correct-answer"><%= q.correctAnswer %></p>
          <% if (review.hasBonus) { %>
            <p class="bonus-answer"><%- icon('plus') %> <%= review.bonusQuestion || 'Papildomas' %>: <strong><%= q.bonus.answer %></strong> <span class="bonus-note">(tik jei pagrindinis teisingas)</span></p>
          <% } %>
          <hr class="section-divider">
          <% if (review.rows.length === 0) { %>
            <p class="typed-answers-empty">Kambaryje nėra komandų.</p>
          <% } %>
          <% review.rows.forEach(function(a, i) {
            const answered = a.links ? a.links.some(Boolean) : !!a.typed;
          %>
            <% if (i > 0) { %><hr class="section-divider"><% } %>
            <div class="typed-answer-team-block">
              <div class="typed-answer-row"
                data-room="<%= roomId %>"
                data-index="<%= q.number - 1 %>"
                data-team="<%= a.teamId %>"
                data-part="main">
                <span class="typed-answer-team"><%= a.teamName %></span>
                <% if (a.links) { %>
                  <ol class="typed-answer-text typed-answer-links">
                    <% a.links.forEach(function(link) { %>
                      <li class="<%= link ? '' : 'is-empty' %>"><%= link || '(neįrašė)' %></li>
                    <% }); %>
                  </ol>
                <% } else { %>
                  <span class="typed-answer-text<%= answered ? '' : ' is-empty' %>"><%= a.typed || (review.mainEditable ? '(neįrašė)' : '(nepasirinko)') %><% if (review.type === 'hints') { %> <span class="hint-lock-note"><% if (a.lockedPoints != null) { %><%- icon('lock') %> <%= a.lockedPoints %> tšk.<% } else { %>neužrakinta · 1 tšk.<% } %></span><% } %></span>
                <% } %>
                <% if (review.mainEditable) { %>
                  <button type="button" class="typed-answer-btn correct-btn<%= a.mainCorrect ? ' active' : '' %>" data-correct="true" title="Teisinga"><%- icon('check') %></button>
                  <button type="button" class="typed-answer-btn wrong-btn<%= a.mainCorrect ? '' : ' active' %>" data-correct="false" title="Neteisinga"><%- icon('close') %></button>
                <% } else { %>
                  <%# A picked option is right or wrong as it is — only shown, not markable. %>
                  <span class="typed-answer-status <%= a.mainCorrect ? 'is-correct' : 'is-wrong' %>"><%- icon(a.mainCorrect ? 'check' : 'close') %></span>
                <% } %>
              </div>
              <% if (review.hasBonus) { %>
                <div class="typed-answer-row is-bonus"
                  data-room="<%= roomId %>"
                  data-index="<%= q.number - 1 %>"
                  data-team="<%= a.teamId %>"
                  data-part="bonus">
                  <span class="typed-answer-team"><%- icon('plus') %> <%= review.bonusQuestion || 'Papildomas' %></span>
                  <span class="typed-answer-text<%= a.bonusTyped ? '' : ' is-empty' %>"><%= a.bonusTyped || '(neįrašė)' %></span>
                  <button type="button" class="typed-answer-btn correct-btn<%= a.bonusCorrect ? ' active' : '' %>" data-correct="true" title="Teisinga"><%- icon('check') %></button>
                  <button type="button" class="typed-answer-btn wrong-btn<%= a.bonusCorrect ? '' : ' active' %>" data-correct="false" title="Neteisinga"><%- icon('close') %></button>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% }); %>
    </div>
  <% } %>

  <nav id="host-bar">
    <div class="host-bar-side">
      <a id="host-bar-exit" class="host-bar-btn" href="/host" title="Atgal į skydelį"><%- icon('close') %></a>
    </div>
    <div class="host-bar-main">
      <button id="next-btn" data-room="<%= roomId %>">Rodyti taškus</button>
    </div>
    <div class="host-bar-end">
      <%- include('_text-scale', { roomId }) %>
    </div>
  </nav>
  <%- include('_team-status', { roomId }) %>
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/host.js"></script>
</body>
</html>
