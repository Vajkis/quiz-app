<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<title><%= title %></title>
<link rel="stylesheet" href="/css/host.css">
<script src="/icons.js"></script>
<script src="/theme.js"></script>
</head>
<body data-nav="host">
<script src="/side-panel.js"></script>
<div id="app">
  <h1><%= roomName %></h1>
  <p id="room-code">Kambario kodas: <strong><%= roomId %></strong></p>

  <div class="stage-intro">
    <p class="stage-intro-label">Etapas <%= stageNumber %> / <%= stageCount %></p>
    <p class="stage-intro-name"><%= stageName %></p>
    <% if (stageTopic) { %><p class="stage-intro-topic"><%= stageTopic %></p><% } %>
    <% if (stageDescription) { %><p class="stage-intro-description"><%= stageDescription %></p><% } %>
  </div>

  <nav id="host-bar">
    <%- include('_bar-toggle', { bar: 'host-bar', key: 'quizHostBarCollapsed' }) %>
    <div class="host-bar-side">
      <a id="host-bar-exit" class="host-bar-btn" href="/host" title="Atgal į skydelį"><%- icon('close') %></a>
    </div>
    <div class="host-bar-main">
      <%# Only the first stage's title goes back (to the rules or the game's name) — never into an earlier stage. %>
      <% if (stageNumber === 1) { %>
        <button id="prev-btn" data-room="<%= roomId %>"><%- icon('arrow-left') %> Atgal</button>
      <% } %>
      <button id="next-btn" data-room="<%= roomId %>">Pradėti etapą</button>
    </div>
    <div class="host-bar-end">
      <%- include('_text-scale', { roomId }) %>
    </div>
  </nav>
  <%- include('_team-status', { roomId }) %>
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/host.js"></script>
</body>
</html>
