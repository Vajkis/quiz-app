<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<title><%= title %></title>
<link rel="stylesheet" href="/css/player.css">
<script src="/icons.js"></script>
<script src="/theme.js"></script>
</head>
<body data-nav="player">
<script src="/side-panel.js"></script>
<div id="app">
  <h1 class="app-title"><%- icon('logo') %><%= title %></h1>

  <div id="join-form">
    <input id="team-input" type="text" placeholder="Komandos pavadinimas arba ID">
    <button id="join-btn">Prisijungti</button>
    <p id="join-error"></p>
  </div>

  <div id="team-info" hidden>
    <%# The team's ID, renaming and logging out are in the side panel (side-panel.js). %>
    <p>Komanda: <strong id="team-name"></strong></p>
  </div>

  <%# Same list as the view screen's dashboard (view/dashboard.ejs). %>
  <div id="room-form" hidden>
    <p id="room-error"><%= error || '' %></p>
    <%# Kept current by room-list.js. %>
    <div id="room-list" data-href-prefix="/">
      <% if (roomList.length) { %>
        <p class="section-label">Aktyvūs kambariai:</p>
        <% roomList.forEach(function(r) { %>
          <a class="option" href="/<%= r.id %>"><%= r.name %> (<%= r.id %>)</a>
        <% }); %>
      <% } else { %>
        <p>Nėra aktyvių kambarių.</p>
      <% } %>
    </div>
  </div>
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/room.js"></script>
<script src="/room-list.js"></script>
</body>
</html>
