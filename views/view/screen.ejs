<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="stylesheet" href="/css/view.css">
</head>
<body data-room="<%= roomId %>"<% if (background) { %> class="has-game-bg" style="--game-bg: url(<%= JSON.stringify(background) %>)"<% } %>>
<div id="app" class="view-app">
  <div id="game-intro-screen" hidden>
    <p class="stage-intro-name" id="game-intro-name"></p>
  </div>

  <div id="game-rules-screen" hidden>
    <p class="stage-intro-label">Taisyklės</p>
    <ul id="game-rules-list" class="game-rules-list"></ul>
  </div>

  <div id="stage-intro-screen" hidden>
    <p class="stage-intro-label" id="stage-intro-label"></p>
    <p class="stage-intro-name" id="stage-intro-name"></p>
    <p class="stage-intro-topic" id="stage-intro-topic" hidden></p>
    <p class="stage-intro-description" id="stage-intro-description" hidden></p>
  </div>

  <div id="view-question" hidden>
    <div id="view-question-box" class="question">
      <div id="view-image-wrap" hidden>
        <img id="view-image" alt="">
      </div>
      <p id="view-question-text"></p>
      <p id="view-bonus-question" hidden></p>
      <div id="audio-progress-wrap" class="audio-progress-wrap" hidden>
        <div class="audio-progress-bar"><div id="audio-progress-fill" class="audio-progress-fill"></div></div>
      </div>
    </div>
    <div id="view-options" class="options-grid"></div>
  </div>

  <div id="stage-review" hidden></div>

  <div id="leaderboard" hidden></div>

  <audio id="view-audio"></audio>
</div>

<div id="fullscreen-overlay" hidden>
  <div id="fullscreen-content"></div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/view.js"></script>
</body>
</html>
